{
  "name": "bargain-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3030 --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "clean": "rm -rf .next node_modules",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare deploy",
    "build:cf": "next build --webpack && find .next -name '._*' -delete && opennextjs-cloudflare build --skipNextBuild --dangerouslyUseUnsupportedNextVersion",
    "cf-typegen": "opennextjs-cloudflare cf-typegen"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@simplewebauthn/browser": "^13.3.0",
    "@stripe/stripe-js": "^9.9.0",
    "firebase": "^12.18.0",
    "next": "16.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.127.1"
  },
  "packageManager": "pnpm@9.15.5"
}
