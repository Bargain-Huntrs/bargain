# Social posting credentials — copy to .env (gitignored) and fill per platform.
# Posting model: X goes through Buffer; everything else posts direct.
#
# Buffer (X + any other channels connected in the Buffer org dashboard)
BUFFER_ACCESS_TOKEN=
BUFFER_ORG_ID=
BUFFER_CHANNEL_IDS=          # optional CSV — blank = post to ALL connected channels
# Direct platforms
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
MASTODON_INSTANCE=
MASTODON_ACCESS_TOKEN=
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_ID=
LINKEDIN_PERSON_ID=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
TUMBLR_BLOG=
TUMBLR_CLIENT_ID=
TUMBLR_CLIENT_SECRET=
TUMBLR_ACCESS_TOKEN=
TUMBLR_REFRESH_TOKEN=
MEDIUM_TOKEN=
NEXTDOOR_CLIENT_ID=
NEXTDOOR_CLIENT_SECRET=
NEXTDOOR_ACCESS_TOKEN=
NEXTDOOR_REFRESH_TOKEN=
NEXTDOOR_PROFILE_ID=
POSTER_UA=
