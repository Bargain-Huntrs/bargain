{
  "name": "bargain-huntrs",
  "version": "0.1.0",
  "private": true,
  "description": "Arbitrage intelligence platform - Find it. Flip it. Profit.",
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky",
    "self-heal": "bash scripts/quick-fix.sh",
    "fix-all": "bash scripts/quick-fix.sh",
    "check-all": "bash scripts/quick-fix.sh",
    "watch:errors": "node scripts/watch-errors.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "playwright-core": "^1.49.0",
    "prettier": "^3.2.5",
    "turbo": "^2.9.18"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": ">=5.0.12",
      "minimatch@8.0.7>brace-expansion": "^2.1.7",
      "fast-uri": ">=3.1.8",
      "js-yaml": ">=4.3.2",
      "nanoid": ">=3.3.18",
      "postcss": ">=8.5.26",
      "serialize-javascript": ">=7.0.3",
      "sharp": ">=0.35.5",
      "proxy-addr": ">=2.0.8",
      "@grpc/grpc-js": ">=1.13.6",
      "source-map-js": ">=1.2.2",
      "undici@>=7.0.0": ">=7.29.1"
    }
  }
}
